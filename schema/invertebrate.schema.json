{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Elwinmage/reeftank-catalog/schema/invertebrate.schema.json",
  "title": "Invertebrate (invertebrates/<id>/species.json)",
  "description": "A shrimp, a snail, a crab, a sea urchin...",
  "type": "object",
  "required": [
    "kind",
    "names",
    "scientific",
    "water_types",
    "size_cm",
    "role",
    "movement"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "invertebrate"
    },
    "names": {
      "$ref": "common.schema.json#/$defs/i18n"
    },
    "scientific": {
      "$ref": "common.schema.json#/$defs/scientific"
    },
    "water_types": {
      "$ref": "common.schema.json#/$defs/water_types"
    },
    "size_cm": {
      "$ref": "common.schema.json#/$defs/size_cm"
    },
    "role": {
      "description": "What it does for the tank.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "detritivore",
          "algae_eater",
          "grazer",
          "cleaner",
          "filter_feeder",
          "scavenger",
          "predator",
          "ornamental"
        ]
      }
    },
    "movement": {
      "description": "Where it moves: on the ground, on the glass, on the decor, fixed, or swimming.",
      "enum": [
        "ground",
        "glass",
        "decor",
        "sessile",
        "swim"
      ]
    },
    "atlas": {
      "description": "Atlas files by name (built).",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "thumbnail": {
      "description": "Thumbnail file (built).",
      "type": "string"
    },
    "frame": {
      "description": "Frame size [width, height] (built).",
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "columns": {
      "description": "Columns of the atlas (built).",
      "type": "integer",
      "minimum": 1
    },
    "clips": {
      "description": "Clips of the atlas (built).",
      "type": "object"
    },
    "facing": {
      "description": "Side the animal faces in the atlas (built).",
      "enum": [
        "left",
        "right"
      ]
    },
    "length_frac": {
      "description": "Share of the frame the animal fills (built).",
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "degraded": {
      "$ref": "common.schema.json#/$defs/degraded"
    },
    "source": {
      "$ref": "common.schema.json#/$defs/source"
    }
  }
}
